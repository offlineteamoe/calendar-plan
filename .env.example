# Copia este archivo a .env.local y completa los valores.
# .env.local nunca se commitea (ver .gitignore, *.local).
#
# Ninguno de estos valores es secreto en el sentido de "hay que esconderlo":
# terminan en el bundle del navegador de todas formas. La seguridad real la
# dan el OAuth consent screen "Internal" del proyecto de Google Cloud detrás
# de Firebase y las reglas de seguridad de Firestore — ver README.md
# "Configuración inicial".

VITE_ALLOWED_DOMAIN=openenglish.com

# Firebase Console > Project settings > General > "Your apps" > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
