# Copia este archivo a .env.local y completa los valores.
# .env.local nunca se commitea (ver .gitignore, *.local).
#
# Ninguno de estos valores es secreto en el sentido de "hay que esconderlo":
# terminan en el bundle del navegador de todas formas. La seguridad real la
# dan el OAuth consent screen "Internal" de Google Cloud y las reglas de
# seguridad de Firestore — ver README.md "Configuración inicial".

VITE_ALLOWED_DOMAIN=openenglish.com

# Google Cloud > APIs & Services > Credentials > OAuth 2.0 Client ID (tipo Web)
VITE_GOOGLE_CLIENT_ID=

# Firebase Console > Project settings > General > "Your apps" > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# IDs de Google Sheets/Drive (ver README, pasos 7-9)
VITE_INDEX_SPREADSHEET_ID=
VITE_TEMPLATE_SPREADSHEET_ID=
VITE_MEDIA_PLANS_FOLDER_ID=
