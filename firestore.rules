rules_version = '2';

// Firestore es la única fuente de datos de esta app (ver pivote de Google
// Sheets a Firestore en el plan de arquitectura): tanto los datos del plan
// (months/{monthKey}/plan|escenario|nota|bloqueo|real|results|creative) como
// la presencia/actividad en tiempo real (presence/, activity/). Nunca
// alcanza con `request.auth != null`: cualquier cuenta de Google podría
// autenticarse en Firebase si solo chequeamos eso. El dominio se valida en
// cada regla.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOeUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@openenglish[.]com$');
    }

    // Datos del plan: un documento por mes, con subcolecciones de datos
    // (plan, escenario, nota, bloqueo, real, results, creative). Todo el
    // equipo puede leer/escribir — es una herramienta interna compartida,
    // no hay permisos por rol en esta fase.
    match /months/{monthKey} {
      allow read: if isOeUser();
      allow create, update, delete: if isOeUser();

      match /{collection}/{docId} {
        allow read, write: if isOeUser();
      }
    }

    match /presence/{monthKey}/users/{uid} {
      allow read: if isOeUser();
      // Cada quien solo puede escribir/borrar su propio documento de presencia.
      allow write: if isOeUser() && request.auth.uid == uid;
    }

    match /activity/{monthKey}/events/{eventId} {
      allow read: if isOeUser();
      allow create: if isOeUser() && request.resource.data.userEmail == request.auth.token.email;
      // El feed de actividad es de solo-creación: nadie edita ni borra eventos pasados.
      allow update, delete: if false;
    }

    // Todo lo demás, denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
