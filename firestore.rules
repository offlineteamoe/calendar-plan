rules_version = '2';

// Firestore es la única fuente de datos de la app: plan, notas, escenarios,
// resultados, creativos, presencia en tiempo real y registro de cambios.
//
// Dos cosas se validan SIEMPRE aquí, no en el navegador:
//
//  1. Dominio. Nunca alcanza con `request.auth != null`: cualquier cuenta de
//     Google puede autenticarse contra Firebase. Se acepta openenglish.com y
//     sus subdominios (hay cuentas en @business.openenglish.com).
//
//  2. Rol. Solo los administradores editan la planificación. El resto del
//     equipo consulta, y lo único que puede escribir son notas de la
//     categoría "observacion". Deshabilitar el botón en la interfaz no es una
//     restricción: esta regla sí lo es.
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth != null ? request.auth.token.email : '';
    }

    function isOeUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@([a-zA-Z0-9-]+[.])*openenglish[.]com$');
    }

    // Lista de arranque, duplicada en src/lib/roles.ts a propósito: si el
    // documento config/roles se borra o queda vacío, estas cuentas siguen
    // pudiendo administrar y arreglarlo. Es la única duplicación, y es la que
    // impide quedarse sin ningún administrador.
    function isBootstrapAdmin() {
      return isOeUser() && email() in [
        'william.fonseca@openenglish.com',
        'cesar.hernandez@openenglish.com',
        'dolores.yanes@business.openenglish.com'
      ];
    }

    function configuredAdmins() {
      return exists(/databases/$(database)/documents/config/roles)
        ? get(/databases/$(database)/documents/config/roles).data.admins
        : [];
    }

    function isAdmin() {
      return isBootstrapAdmin() || (isOeUser() && email() in configuredAdmins());
    }

    // La lista de administradores: la lee cualquiera del dominio (la interfaz
    // necesita saber qué mostrar), la cambia solo un administrador de arranque.
    match /config/roles {
      allow read: if isOeUser();
      allow write: if isBootstrapAdmin();
    }

    match /months/{monthKey} {
      allow read: if isOeUser();
      allow create, update, delete: if isAdmin();

      // Notas. Quién puede tocar qué:
      //   · crear  → un administrador, cualquier categoría; un usuario de
      //              consulta, solo "observacion" firmada con su correo.
      //   · editar → una nota de consulta la edita SOLO quien la escribió;
      //              una nota de administrador, cualquier administrador.
      //   · borrar → su autor, o un administrador.
      // Editar nunca puede reescribir la autoría ni la fecha de creación: eso
      // es lo que hace que el historial de la nota sea confiable.
      match /nota/{docId} {
        function ownObservacion(data) {
          return isOeUser()
            && data.kind == 'observacion'
            && data.created_by == email();
        }
        function isViewerNote(data) {
          return data.get('created_by_role', 'admin') == 'viewer' || data.kind == 'observacion';
        }
        function identityKept() {
          return request.resource.data.note_id == resource.data.note_id
            && request.resource.data.created_by == resource.data.created_by
            && request.resource.data.created_at == resource.data.created_at
            && request.resource.data.get('created_by_role', 'admin') == resource.data.get('created_by_role', 'admin');
        }
        allow read: if isOeUser();
        allow create: if isAdmin() || ownObservacion(request.resource.data);
        allow update: if identityKept() && (
          isViewerNote(resource.data)
            ? (isOeUser() && resource.data.created_by == email())
            : isAdmin()
        );
        allow delete: if isAdmin() || (isOeUser() && resource.data.created_by == email());
      }

      // El registro de cambios lo escribe cualquiera del dominio, porque
      // también deja rastro de las observaciones. Nadie puede editarlo ni
      // borrarlo: es un historial, no un dato editable.
      //
      // Leerlo es otra cosa: quién hizo qué en el plan lo ve el equipo que
      // administra. Un usuario de consulta solo alcanza su propio rastro.
      // Ojo: Firestore no filtra una consulta, la rechaza entera — por eso el
      // cliente pide explícitamente `user_email == su correo` (ver
      // src/hooks/useChanges.ts y listChangesForDoc).
      match /changes/{changeId} {
        allow read: if isAdmin() || (isOeUser() && resource.data.user_email == email());
        allow create: if isOeUser();
        allow update, delete: if false;
      }

      // Resto de subcolecciones (plan, versiones, escenarios, resultados,
      // creativos, bloqueos, real): todo el dominio lee, solo admin escribe.
      match /{collection}/{docId} {
        allow read: if isOeUser();
        allow write: if isAdmin();
      }
    }

    // Consultas de grupo de colección: el registro de actividad global
    // (página /logs) y el resumen de aprobación de la lista de meses.
    match /{path=**}/changes/{changeId} {
      allow read: if isAdmin() || (isOeUser() && resource.data.user_email == email());
    }
    match /{path=**}/versions/{versionId} {
      allow read: if isOeUser();
    }

    match /presence/{monthKey}/users/{uid} {
      allow read: if isOeUser();
      // Cada quien solo escribe/borra su propio documento de presencia.
      allow write: if isOeUser() && request.auth.uid == uid;
    }

    // Todo lo demás, denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
