rules_version = '2';

// Firestore es la única fuente de datos de la app: datos del plan
// (months/{monthKey}/plan|nota|escenario|bloqueo|changes|…), presencia en
// tiempo real y registro de cambios.
//
// Nunca alcanza con `request.auth != null`: cualquier cuenta de Google podría
// autenticarse en Firebase. El dominio se valida en CADA regla.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOeUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@openenglish[.]com$');
    }

    // Un documento por mes, con sus subcolecciones de datos. Todo el equipo
    // puede leer y escribir: es una herramienta interna compartida.
    match /months/{monthKey} {
      allow read: if isOeUser();
      allow create, update, delete: if isOeUser();

      match /{collection}/{docId} {
        allow read, write: if isOeUser();
      }
    }

    // Consulta de grupo de colección para el registro de actividad global
    // (página /logs), que lee los cambios de todos los meses de una vez.
    match /{path=**}/changes/{changeId} {
      allow read: if isOeUser();
    }

    match /presence/{monthKey}/users/{uid} {
      allow read: if isOeUser();
      // Cada quien solo escribe/borra su propio documento de presencia.
      allow write: if isOeUser() && request.auth.uid == uid;
    }

    // Todo lo demás, denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
